#!/usr/bin/env python3
"""Treat a subdirectory of another repo as a plain git remote.

The game lives in Hot_Springs_Idle/ of StopSign/stopsign.github.io. This mirrors that subdirectory's history as a
linear branch, refs/remotes/upstream/master, whose commits hold just the subdirectory's tree at the repo root (like
`git subtree split`). Merge it like any remote branch:

    tools/git-upstream fetch        # update upstream/master
    git log HEAD..upstream/master   # what's new
    git merge upstream/master       # or: tools/git-upstream merge

Each mirrored commit keeps the upstream author, committer, dates and message and adds an `Upstream-Commit: <sha>`
trailer, so mirroring is deterministic: any clone rebuilds identical SHAs. On the first run the chain continues from
the newest commit in HEAD's history that names an upstream commit (that trailer, or a subject `import <sha>`).

The upstream repo is kept as a blobless partial clone under .git/upstream/; only blobs inside the subdirectory are
downloaded, then copied into this repo so it never depends on the cache.

Settings (git config, all optional): upstream.url, upstream.branch, upstream.prefix.
"""
import os
import re
import subprocess
import sys

DEFAULTS = {"url": "https://github.com/StopSign/stopsign.github.io.git", "branch": "master", "prefix": "Hot_Springs_Idle"}
TRAILER = "Upstream-Commit"


def git(*args, cwd=None, env=None, stdin=None, check=True):
    r = subprocess.run(["git", *args], cwd=cwd, env=env, input=stdin, capture_output=True, text=True)
    if check and r.returncode != 0:
        sys.exit(f"git {' '.join(args)} failed:\n{r.stderr.strip()}")
    return r.stdout.strip()


def setting(name):
    return git("config", "--get", f"upstream.{name}", check=False) or DEFAULTS[name]


def update_cache(cache, url, branch):
    if not os.path.isdir(cache):
        print(f"Cloning {url} (blobless) into {cache}")
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        subprocess.run(["git", "clone", "--bare", "--filter=blob:none", "--single-branch", "--branch", branch, url, cache], check=True)
    else:
        subprocess.run(["git", "-C", cache, "fetch", "--no-tags", "origin", f"+refs/heads/{branch}:refs/heads/{branch}"], check=True)


def upstream_sha_of(commit_msg, cache):
    m = re.search(rf"^{TRAILER}: *([0-9a-f]{{7,40}})\s*$", commit_msg, re.M) or re.match(r"import ([0-9a-f]{7,40})\s*$", commit_msg)
    if not m:
        return None
    return git("-C", cache, "rev-parse", "--verify", "--quiet", m.group(1) + "^{commit}", check=False) or None


def find_base(tracking, cache):
    """(our commit, upstream commit it mirrors): the tracking branch's tip, else the newest mirror in HEAD's history."""
    tip = git("rev-parse", "--verify", "--quiet", tracking, check=False)
    candidates = [tip] if tip else git("rev-list", "--topo-order", "HEAD").split()
    for c in candidates:
        sha = upstream_sha_of(git("log", "-1", "--format=%B", c), cache)
        if sha:
            return c, sha
    sys.exit(f"No commit in HEAD's history names an upstream commit ({TRAILER}: <sha> trailer or 'import <sha>' subject).")


def fetch():
    url, branch, prefix = setting("url"), setting("branch"), setting("prefix")
    cache = os.path.join(git("rev-parse", "--path-format=absolute", "--git-common-dir"), "upstream", re.sub(r"\W+", "_", url) + ".git")
    tracking = f"refs/remotes/upstream/{branch}"
    update_cache(cache, url, branch)
    base, last = find_base(tracking, cache)
    commits = git("-C", cache, "rev-list", "--reverse", "--first-parent", "--topo-order", f"{last}..{branch}", "--", prefix).split()
    trees = [(c, git("-C", cache, "rev-parse", f"{c}:{prefix}", check=False)) for c in commits]
    trees = [(c, t) for c, t in trees if t]
    if not trees:
        git("update-ref", tracking, base)
        print(f"upstream/{branch} is up to date ({last[:9]}).")
        return
    # Download the subdirectory's missing blobs in one batch rather than lazily one by one.
    missing = [l[1:] for l in git("-C", cache, "rev-list", "--objects", "--missing=print", *[t for _, t in trees]).splitlines() if l.startswith("?")]
    if missing:
        print(f"Downloading {len(missing)} blobs")
        git("-C", cache, "fetch", "--no-tags", "--no-write-fetch-head", "--filter=blob:none", "--stdin", "origin", stdin="\n".join(missing) + "\n")
    env = dict(os.environ, GIT_ALTERNATE_OBJECT_DIRECTORIES=os.path.join(cache, "objects"))
    parent = base
    parent_tree = git("rev-parse", f"{base}^{{tree}}")
    for c, tree in trees:
        if tree == parent_tree:
            continue
        an, ae, ad, cn, ce, cd = git("-C", cache, "log", "-1", "--date=raw", "--format=%an%x00%ae%x00%ad%x00%cn%x00%ce%x00%cd", c).split("\x00")
        msg = git("-C", cache, "log", "-1", "--format=%B", c)
        msg = f"{msg}\n\n{TRAILER}: {c}\n"
        cenv = dict(env, GIT_AUTHOR_NAME=an, GIT_AUTHOR_EMAIL=ae, GIT_AUTHOR_DATE=ad, GIT_COMMITTER_NAME=cn, GIT_COMMITTER_EMAIL=ce, GIT_COMMITTER_DATE=cd)
        parent = git("commit-tree", "--no-gpg-sign", tree, "-p", parent, env=cenv, stdin=msg)
        parent_tree = tree
        print(f"  {parent[:9]} <- {c[:9]} {msg.splitlines()[0]}")
    # Copy the new objects into this repo so nothing depends on the cache.
    objects = git("rev-list", "--objects", parent, "--not", base, env=env)
    pack_dir = os.path.join(git("rev-parse", "--path-format=absolute", "--git-path", "objects/pack"), "pack")
    git("pack-objects", "-q", pack_dir, env=env, stdin="\n".join(l.split(" ")[0] for l in objects.splitlines()) + "\n")
    git("update-ref", "-m", "git-upstream fetch", tracking, parent)
    print(f"upstream/{branch} -> {parent[:9]} (mirrors {trees[-1][0][:9]})")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "fetch"
    if cmd == "fetch":
        fetch()
    elif cmd == "merge":
        fetch()
        os.execvp("git", ["git", "merge", f"upstream/{setting('branch')}", *sys.argv[2:]])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
